@startuml SequenceRealtimeVoiceAgentRAG

actor "User" as user
boundary "UI: Đàm thoại AI" as ui_voice
control "LiveKit WebRTC\nServer" as livekit
control "LiveKit Voice\nAgent Worker" as agent
control "Semantic Grounding\nRouter" as router
control "Hybrid RAG\nService" as rag
entity "OpenAI Realtime" as openai
control "Internet Search\nService" as internet_search

activate user
user -> ui_voice: Bắt đầu phiên đàm thoại
activate ui_voice

ui_voice -> livekit: Connect room WebRTC
activate livekit
livekit --> ui_voice: Connect success
deactivate livekit

ui_voice -> livekit: User Voice
activate livekit
livekit -> agent: Audio stream
activate agent
deactivate livekit

agent -> router: Phân tích ý định
activate router
router -> router: Phân loại ý định

alt#Gold #LightBlue Câu hỏi thuộc phạm vi sách
    router -> rag: Hybrid RAG retrieval
    deactivate router
    activate rag
    rag -> rag: RRF\nCohere Reranker
    rag --> agent: Chunks reranked
    deactivate rag

    agent -> openai: Đóng gói context cùng các chunk
    activate openai
    openai --> agent: Audio stream
    deactivate openai
else #Pink Câu hỏi nằm ngoài phạm vi sách
    router --> agent: Yêu cầu Internet search
    deactivate router

    agent -> ui_voice: Internet Search Permission
    ui_voice --> user: Yêu cầu cấp quyền
    user -> ui_voice: Đồng ý cấp quyền
    ui_voice -> agent: Xác nhận đã cấp quyền

    agent -> internet_search: Internet Search
    activate internet_search
    internet_search --> agent: Kết quả từ Internet search
    deactivate internet_search

    agent -> openai: Tổng hợp phản hồi từ kết quả tìm kiếm
    activate openai
    openai --> agent: Luồng phản hồi âm thanh thời gian thực
    deactivate openai
end

agent -> livekit: Audio stream
activate livekit
livekit -> ui_voice: Audio stream
deactivate livekit

ui_voice --> user: Audio stream

deactivate agent
deactivate ui_voice
deactivate user

@enduml
