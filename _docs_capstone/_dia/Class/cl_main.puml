@startuml TRIAM_ClassDiagram_Final
left to right direction

' ================= ACTORS & USER MANAGEMENT =================

class User {
    + ID: string
    + email: string
    + displayName: string
    
    + login(): void
    + logout(): void
}

class AdminUser {
    + role: string
    + isActive: bool
    + note: string
    
    + canAccessAdmin(): bool
}

class AdminAuditLog {
    + ID: string
    + action: string
    + targetType: string
    + metadata: jsonb
}

' ================= CORE BUSINESS (DOCUMENTS & PLANS) =================

class Book {
    + ID: string
    + title: string
    + author: string
    + fileUrl: string
    + documentType: string
    + totalSections: int
    + totalUnits: int
    + status: string
    
    + validateStructure(): bool
}

class BookSection {
    + ID: string
    + sectionIndex: int
    + title: string
    + level: int
    + path: string
    + textContent: text
}

class BookSectionKnowledge {
    + ID: string
    + chunkIndex: int
    + content: text
    + searchText: text
    + contentHash: string
    + embeddingModel: string
    + embeddingVersion: string
    + embedding: vector
}

class ReadingPlan {
    + ID: string
    + mode: string
    + pace: int
    + status: string
    + reminderTime: string
    
    + activate(): void
}

class ReadingPlanScheduleSlot {
    + ID: string
    + weekday: int
    + reminderTime: string
    + timezone: string
    + isActive: bool
}

class ReadingPlanSession {
    + ID: string
    + mode: string
    + sessionIndex: int
    + scheduledAt: date
    + status: string
}

class ProcessingJob {
    + ID: string
    + jobType: string
    + status: string
    + mode: string
    + progressPercent: int
    + currentStep: string
    
    + updateProgress(): void
}

' ================= LEARNING & AUDIO PROGRESS =================

class LearningUnit {
    + ID: string
    + mode: string
    + unitIndex: int
    + title: string
    + status: string
    + reviewAudioUrl: string
    + reviewText: text
}

class LearningUnitSegment {
    + ID: string
    + segmentIndex: int
    + audioUrl: string
    + textContent: text
    + durationMs: int
}

class LearningUnitProgress {
    + ID: string
    + positionMs: int
    + progressPercent: int
    + status: string
}

class BookLearningState {
    + ID: string
    + mode: string
    + status: string
    + bookProgressPercent: int
}

' ================= AI ASSISTANT & REVIEW =================

class StudyContext {
    + ID: string
    + title: string
    + isAutoGenerated: bool
}

class ChatThread {
    + ID: string
    + title: string
}

class ChatMessage {
    + ID: string
    + isUser: bool
    + text: text
    + source: string
}

class SpacedReviewItem {
    + ID: string
    + intervalDays: int
    + dueAt: date
    + status: string
}

' ================= NOTIFICATIONS =================

class NotificationSettings {
    + timezone: string
    + remindersEnabled: bool
    + spacedReviewEnabled: bool
    + reminderTime: string
}

class NotificationOutbox {
    + ID: string
    + type: string
    + channel: string
    + status: string
    + idempotencyKey: string
}

class UserNotification {
    + ID: string
    + type: string
    + title: string
    + body: text
    + readAt: date
}

' ================= RELATIONSHIPS =================

' Kế thừa và quản trị bảo mật
AdminUser --|> User
AdminUser "1" -- "n" AdminAuditLog: "writes"

' Cấu hình tài khoản và thông báo
User "1" -- "1" NotificationSettings: "configures"
User "1" -- "n" UserNotification: "receives"
NotificationOutbox "1" -- "0..1" UserNotification: "generates"

' Tài liệu và cấu trúc tri thức RAG
User "1" -- "n" Book: "uploads"
Book "1" -- "n" BookSection: "contains"
BookSection "1" -- "n" BookSectionKnowledge: "chunks"
Book "1" -- "n" BookSectionKnowledge: "RAG index"

' Lập lịch và xử lý Job bất đồng bộ
Book "1" -- "n" ReadingPlan: "has"
ReadingPlan "1" -- "n" ReadingPlanScheduleSlot: "configured with"
ReadingPlan "1" -- "n" ReadingPlanSession: "generates"
Book "1" -- "n" ProcessingJob: "tracks"

' Tiến trình học và file audio bài học
Book "1" -- "n" LearningUnit: "splits into"
LearningUnit "1" -- "n" LearningUnitSegment: "has segments"
User "1" -- "n" LearningUnitProgress: "tracks unit"
LearningUnit "1" -- "n" LearningUnitProgress: "tracked by"
User "1" -- "n" BookLearningState: "tracks book"
Book "1" -- "n" BookLearningState: "tracked by"

' Không gian tương tác với Trợ lý AI
User "1" -- "n" StudyContext: "creates"
StudyContext "n" -- "n" Book: "targets"
StudyContext "1" -- "n" ChatThread: "owns"
ChatThread "1" -- "n" ChatMessage: "stores"
ChatThread "n" ..> BookSectionKnowledge: "queries"

' Ôn tập ngắt quãng
User "1" -- "n" SpacedReviewItem: "reviews"
LearningUnit "1" -- "n" SpacedReviewItem: "scheduled for"

@enduml