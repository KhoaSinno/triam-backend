@startuml TRIAM_ClassDiagram_Report
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam roundcorner 14
hide circle

left to right direction

class User <<Supabase Auth>> {
+id: UUID
+email: String
+displayName: String
+login(): void
+logout(): void
}

class Book {
+id: UUID
+title: String
+author: String
+documentType: String
+status: BookStatus
+validateStructure(): Boolean
+markPartialReady(): void
+markReady(): void
}

class BookSection {
+id: UUID
+title: String
+level: Integer
+path: String
+textContent: Text
+getFullPath(): String
}

class BookSectionKnowledge {
+id: Integer
+chunkIndex: Integer
+content: Text
+searchText: Text
+embedding: Vector
}

class ReadingPlan {
+id: UUID
+mode: PlanMode
+pace: Integer
+scheduleConfig: JSON
+reminderTime: String
+activate(): void
}

class ProcessingJob {
+id: UUID
+jobType: ProcessingJobType
+status: ProcessingJobStatus
+progressPercent: Integer
+currentStep: String
+updateProgress(): void
+markReady(): void
}

class LearningUnit {
+id: UUID
+mode: PlanMode
+unitIndex: Integer
+title: String
+status: ProcessingJobStatus
+reviewAudioUrl: String
+reviewText: Text
+isPlayable(): Boolean
}

class LearningUnitSegment {
+id: Integer
+segmentIndex: Integer
+audioUrl: String
+textContent: Text
+durationMs: Integer
}

class LearningUnitProgress {
+id: UUID
+positionMs: Integer
+progressPercent: Integer
+status: LearningProgressStatus
+updatePosition(): void
+complete(): void
}

class SpacedReviewItem {
+id: UUID
+intervalDays: Integer
+dueAt: DateTime
+status: ReviewItemStatus
+complete(): void
+skip(): void
}

class StudyContext {
+id: UUID
+title: String
+isAutoGenerated: Boolean
+addBook(): void
+createThread(): ChatThread
}

class ChatThread {
+id: UUID
+title: String
+addMessage(): void
}

class ChatMessage {
+id: UUID
+isUser: Boolean
+text: Text
+source: String
+timestamp: DateTime
}

class NotificationSettings {
+userId: UUID
+remindersEnabled: Boolean
+spacedReviewEnabled: Boolean
+reminderTime: String
}

class UserNotification {
+id: UUID
+type: NotificationType
+title: String
+body: Text
+readAt: DateTime
+markRead(): void
}

class AdminUser {
+userId: UUID
+role: String
+isActive: Boolean
+canAccessAdmin(): Boolean
}

class AdminAuditLog {
+id: UUID
+action: String
+targetType: String
+metadata: JSON
}

User "1" -- "0..*" Book : owns
User "1" -- "0..*" StudyContext : owns
User "1" -- "0..*" LearningUnitProgress : tracks
User "1" -- "0..*" SpacedReviewItem : reviews
User "1" -- "1" NotificationSettings : configures
User "1" -- "0..*" UserNotification : receives
User "1" -- "0..1" AdminUser : may be

Book "1" *-- "1..*" BookSection : contains
BookSection "0..1" -- "0..*" BookSection : parent/child
Book "1" -- "0..*" ReadingPlan : has
Book "1" -- "0..*" ProcessingJob : tracks
Book "1" *-- "0..*" LearningUnit : generates
Book "1" *-- "0..*" BookSectionKnowledge : RAG index
BookSection "1" -- "0..*" BookSectionKnowledge : chunks

LearningUnit "1" *-- "0..*" LearningUnitSegment : has audio segments
LearningUnit "1" -- "0..*" LearningUnitProgress : tracked by
LearningUnit "1" -- "0..*" SpacedReviewItem : reviewed by

StudyContext "0..*" -- "0..*" Book : contains
StudyContext "1" *-- "0..*" ChatThread : owns
ChatThread "1" *-- "0..*" ChatMessage : stores
ChatThread "0..*" ..> BookSectionKnowledge : queries RAG

AdminUser "1" -- "0..*" AdminAuditLog : writes
AdminUser "0..*" ..> Book : manages catalog/books
AdminUser "0..*" ..> ProcessingJob : monitors/retries

@enduml
