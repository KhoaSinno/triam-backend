@startuml triam_usecase_admin
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam roundcorner 14
skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}

left to right direction

actor "Quản trị viên" as Admin

rectangle "Phân hệ Quản trị hệ thống" {
  (Quản trị hệ thống) as UC_AdminSystem
  (Xem dashboard) as UC_AdminDashboard
  (Quản lý người dùng) as UC_AdminUser
  (Quản lý catalog sách) as UC_AdminCatalog
  (Giám sát & retry job lỗi) as UC_AdminJob
  (Xem audit log) as UC_Audit

  UC_AdminSystem ..> UC_AdminDashboard : <<include>>
  UC_AdminSystem ..> UC_AdminUser : <<include>>
  UC_AdminSystem ..> UC_AdminCatalog : <<include>>
  UC_AdminSystem ..> UC_AdminJob : <<include>>
  UC_AdminSystem ..> UC_Audit : <<include>>
}

Admin -- UC_AdminSystem
@enduml