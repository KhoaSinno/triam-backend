@startuml triam_usecase_overview
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
' skinparam defaultFontSize 13
' skinparam roundcorner 18
' skinparam linetype ortho
' skinparam packageStyle rectangle
' skinparam nodesep 50
' skinparam ranksep 50

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
  FontColor #111827
}
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #111827
}

left to right direction

actor "User" as Reader
actor "Admin" as Admin

rectangle "UseCase tổng quan" {
  (Quản lý phiên đàm thoại) as UC_Account
  (Quản lý thư viện sách cá nhân) as UC_LibraryPlan
  (Quản lý kế hoạch học tập) as UC_ListenProgress
  (Quản lý phiên đàm thoại AI) as UC_AI
  (Quản lý không gian học tập) as UC_Workspace
  (Quản lý lịch ôn tập) as UC_Review
  (Quản lý thông báo cá nhân) as UC_Notification

  (Quản trị hệ thống) as UC_AdminSystem
}

Reader -- UC_Account
Reader -- UC_LibraryPlan
Reader -- UC_ListenProgress
Reader -- UC_AI
Reader -- UC_Workspace
Reader -- UC_Review
Reader -- UC_Notification

Admin -- UC_AdminSystem
Reader <|- Admin
@enduml