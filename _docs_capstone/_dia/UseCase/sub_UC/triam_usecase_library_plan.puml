@startuml triam_usecase_library_plan
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
' skinparam roundcorner 14
' skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #FEF3C7
  BorderColor #B45309
}

left to right direction

actor "Độc giả" as Reader

rectangle "Phân hệ Tài liệu & Kế hoạch học" {
  (Upload sách) as UC_UploadBook
  ' TODO: Hiện tại chưa có Chọn sách từ thư viện
  (Chọn sách từ thư viện) as UC_SelectBook

  (Tạo kế hoạch học mới) as UC_CreatePlan
  (Chọn chế độ học) as UC_SelectMode
  (Theo dõi tiến trình xử lý) as UC_TrackJob
  (Nghe sớm bài học) as UC_ListenEarly

  ' Mũi tên hướng từ tính năng mở rộng về tính năng gốc
  UC_ListenEarly ..> UC_TrackJob : <<extend>>
}

Reader -- UC_UploadBook
Reader -- UC_SelectBook
Reader -- UC_CreatePlan
Reader -- UC_SelectMode
Reader -- UC_TrackJob
@enduml