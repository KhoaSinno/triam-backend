@startuml triam_usecase_library_plan
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
' skinparam roundcorner 14
' skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #FEF3C7
  BorderColor #B45309
}

left to right direction

actor "User" as Reader

rectangle "Phân hệ: Tài liệu và kế hoạch học" {
  (Upload sách) as UC_UploadBook
  (Chọn sách từ thư viện) as UC_SelectBook
  (Tạo và điều chỉnh kế hoạch học tập) as UC_CreatePlan
  (Xem tóm tắt AI của sách) as UC_AI_SUM
  (Tạo lại tóm tắt) as UC_RE_AI_SUM
  (Theo dõi tiến trình xử) as UC_TrackJob
  (Nghe sớm bài học) as UC_ListenEarly

  ' Mũi tên hướng từ tính năng mở rộng về tính năng gốc
  UC_TrackJob <.. UC_ListenEarly  : <<extend>>
}

Reader -- UC_UploadBook
Reader -- UC_SelectBook
Reader -- UC_CreatePlan
Reader -- UC_AI_SUM
Reader -- UC_TrackJob

UC_AI_SUM <.. UC_RE_AI_SUM : <<extend>>
@enduml