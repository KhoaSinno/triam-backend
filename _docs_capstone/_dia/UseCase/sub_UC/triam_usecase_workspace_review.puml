@startuml triam_usecase_workspace_review
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
' skinparam roundcorner 14
' skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #FEF3C7
  BorderColor #B45309
}

left to right direction

actor "Độc giả" as Reader

rectangle "Phân hệ Không gian học, Ôn tập và Thông báo" {
  (Quản lý Không gian) as UC_Workspace
  (Xem lịch ôn tập) as UC_Review
  (Quản lý thông báo) as UC_Notification

  (Liên kết sách vào không gian) as UC_ManageWSBooks
  (Khởi tạo hội thoại trong không gian) as UC_WSChat
  (Hội thoại trực tiếp với sách) as UC_DirectChat

  ' Các chức năng con của Quản lý không gian sử dụng quan hệ mở rộng (extend)
  UC_Workspace <.. UC_ManageWSBooks : <<extend>>
  UC_Workspace <.. UC_WSChat : <<extend>>
  UC_Workspace <.. UC_DirectChat : <<extend>>
}

Reader -- UC_Workspace
Reader -- UC_Review
Reader -- UC_Notification
@enduml