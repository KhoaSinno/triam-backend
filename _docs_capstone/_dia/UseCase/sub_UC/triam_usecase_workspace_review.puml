@startuml triam_usecase_workspace_review
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam roundcorner 14
skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #FFE4E6
  BorderColor #BE123C
}

left to right direction

actor "Độc giả" as Reader

rectangle "Phân hệ Workspace, Ôn tập & Thông báo" {
  (Quản lý Workspace & Ôn tập) as UC_WorkspaceReview
  (Quản lý workspace & luồng chat) as UC_Workspace
  (Xem lịch ôn tập ngắt quãng) as UC_Review
  (Cấu hình & nhận thông báo) as UC_Notification

  UC_WorkspaceReview ..> UC_Workspace : <<include>>
  UC_WorkspaceReview ..> UC_Review : <<include>>
  UC_WorkspaceReview ..> UC_Notification : <<include>>
}

Reader -- UC_WorkspaceReview
@enduml