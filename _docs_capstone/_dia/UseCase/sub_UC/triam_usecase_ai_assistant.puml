@startuml triam_usecase_ai_assistant
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam roundcorner 14
skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #F3E8FF
  BorderColor #6B21A8
}

left to right direction

actor "Độc giả" as Reader
actor "Tavily API (Internet)" as Tavily

rectangle "Phân hệ Trợ lý AI theo ngữ cảnh" {
  (Tương tác với trợ lý AI) as UC_AIAssistant
  (Hỏi đáp bằng Text/Voice thường) as UC_QA
  (Đàm thoại LiveKit thời gian thực) as UC_LiveKit
  (Tìm kiếm Internet qua Tavily) as UC_Web

  ' Quan hệ kế thừa (đầu mũi tên tam giác rỗng liền nét)
  UC_QA -|> UC_AIAssistant
  UC_LiveKit -|> UC_AIAssistant

  ' Quan hệ mở rộng khi cần tra cứu thông tin ngoài luồng
  UC_Web ..> UC_QA : <<extend>>
}

Reader -- UC_AIAssistant
UC_Web -- Tavily
@enduml