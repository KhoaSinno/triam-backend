@startuml triam_usecase_ai_assistant
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
' skinparam roundcorner 14
' skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam usecase {
  BackgroundColor #FEF3C7
  BorderColor #B45309
}

left to right direction

actor "Độc giả" as Reader
' actor "Tavily API (Internet)" as Tavily

rectangle "Phân hệ Trợ lý AI theo ngữ cảnh sách" {
  (Hỏi đáp bằng Text/Voice thường) as UC_QA
  (Đàm thoại LiveKit thời gian thực) as UC_LiveKit
  (Truy xuất ngữ nghĩa từ tài liệu - RAG) as UC_RAG
  (Tìm kiếm Internet) as UC_Web
  (Cấp quyền tìm kiếm ngoài tài liệu) as UC_Perm

  ' Hỏi đáp và Đàm thoại đều bắt buộc phải truy xuất ngữ nghĩa từ tài liệu (RAG)
  UC_QA .> UC_RAG : <<include>>
  UC_LiveKit .> UC_RAG : <<include>>

  ' Quan hệ mở rộng tìm kiếm ngoài
  UC_QA <.. UC_Web : <<extend>>
  UC_LiveKit <.. UC_Web : <<extend>>

  ' Tìm kiếm ngoài bắt buộc phải hỏi xin quyền từ người học
  UC_Web ..> UC_Perm : <<include>>
}

Reader -- UC_QA
Reader -- UC_LiveKit
@enduml