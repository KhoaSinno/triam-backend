@startuml TRIAM_UseCase_LoggedIn_Clean
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 18
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
  FontColor #111827
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #1E3A8A
  FontColor #111827
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #111827
}
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #111827
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #FB923C
  FontColor #7C2D12
}

left to right direction

actor "Đọc giả\n(đã đăng nhập)" as Reader
actor "Admin\n(đã đăng nhập)" as Admin
Admin -|> Reader

rectangle "TRIAM Assistant - Hệ thống sách nói AI" {

  package "Tài liệu & kế hoạch học" #ECFDF5 {
    (Quản lý thư viện sách) as UC_Library
    (Tải lên / chọn sách) as UC_SelectBook
    (Kiểm tra cấu trúc tài liệu) as UC_Validate
    (Tạo kế hoạch học) as UC_CreatePlan
    (Chọn chế độ Full/Pareto) as UC_Mode
    (Theo dõi tiến trình xử lý) as UC_TrackJob
  }

  package "Nghe sách nói & tiến độ" #FEF3C7 {
    (Xem playlist bài học) as UC_Playlist
    (Nghe audio bài học) as UC_Listen
    (Nghe sớm khi partial_ready) as UC_ListenEarly
    (Chuyển đổi chế độ học) as UC_SwitchMode
    (Cập nhật tiến độ nghe) as UC_Progress
  }

  package "Trợ lý AI theo ngữ cảnh" #F3E8FF {
    (Hỏi đáp Text/Voice) as UC_QA
    (Kết nối phòng thoại LiveKit) as UC_LiveKit
    (Truy xuất kiến thức sách bằng RAG) as UC_RAG
    (Tìm kiếm Internet khi được bật) as UC_Web
    (Lưu lịch sử hội thoại) as UC_SaveChat
  }

  package "Workspace, ôn tập & thông báo" #FFE4E6 {
    (Quản lý workspace) as UC_Workspace
    (Quản lý luồng chat) as UC_Thread
    (Xem lịch ôn tập) as UC_Review
    (Hoàn thành/Bỏ qua ôn tập) as UC_ReviewDone
    (Cấu hình & nhận thông báo) as UC_Notification
  }

  package "Quản trị hệ thống" #F1F5F9 {
    (Xem dashboard) as UC_AdminDashboard
    (Quản lý người dùng) as UC_AdminUser
    (Quản lý catalog sách) as UC_AdminCatalog
    (Upload/Publish sách hệ thống) as UC_AdminBook
    (Giám sát & retry job xử lý) as UC_AdminJob
    (Xem audit log) as UC_Audit
  }

  package "Xử lý nền qua Worker" #F8FAFC {
    (Thực thi pipeline xử lý sách) as UC_WorkerPipeline
    (Sinh audio bài học) as UC_GenAudio
    (Tạo knowledge base/RAG) as UC_GenRAG
    (Cập nhật ProcessingJob) as UC_UpdateJob
    (Mở khóa Listen Early) as UC_UnlockEarly
    (Tạo nhắc nhở ôn tập) as UC_GenReminder
  }

  note bottom of UC_WorkerPipeline
    Worker/Celery là thành phần nội bộ của hệ thống,
    không phải actor ngoài hệ thống.
    Nó chỉ xuất hiện như use case nội bộ được <<include>>
    từ các nghiệp vụ cần xử lý nền.
  end note
}

Reader --> UC_Library
Reader --> UC_CreatePlan
Reader --> UC_Listen
Reader --> UC_QA
Reader --> UC_Workspace
Reader --> UC_Review
Reader --> UC_Notification
Reader --> UC_SwitchMode

Admin --> UC_AdminDashboard
Admin --> UC_AdminUser
Admin --> UC_AdminCatalog
Admin --> UC_AdminJob
Admin --> UC_Audit

UC_Library ..> UC_SelectBook : <<include>>
UC_SelectBook ..> UC_Validate : <<include>>
UC_CreatePlan ..> UC_Mode : <<include>>
UC_CreatePlan ..> UC_WorkerPipeline : <<include>>
UC_CreatePlan ..> UC_TrackJob : <<include>>
UC_TrackJob ..> UC_ListenEarly : <<extend>>

UC_Listen ..> UC_Playlist : <<include>>
UC_Listen ..> UC_Progress : <<include>>
UC_ListenEarly ..> UC_Listen : <<extend>>
UC_SwitchMode ..> UC_WorkerPipeline : <<include>>

UC_QA ..> UC_LiveKit : <<extend>>
UC_QA ..> UC_RAG : <<include>>
UC_QA ..> UC_SaveChat : <<include>>
UC_QA ..> UC_Web : <<extend>>

UC_Workspace ..> UC_Thread : <<include>>
UC_Thread ..> UC_SaveChat : <<include>>
UC_Review ..> UC_ReviewDone : <<include>>
UC_Notification ..> UC_GenReminder : <<include>>

UC_AdminCatalog ..> UC_AdminBook : <<include>>
UC_AdminBook ..> UC_Validate : <<include>>
UC_AdminBook ..> UC_WorkerPipeline : <<include>>
UC_AdminJob ..> UC_WorkerPipeline : <<extend>>

UC_WorkerPipeline ..> UC_GenAudio : <<include>>
UC_WorkerPipeline ..> UC_GenRAG : <<include>>
UC_WorkerPipeline ..> UC_UpdateJob : <<include>>
UC_WorkerPipeline ..> UC_UnlockEarly : <<extend>>
UC_GenReminder ..> UC_Notification : <<extend>>

@enduml