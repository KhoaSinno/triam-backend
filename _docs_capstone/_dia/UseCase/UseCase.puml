@startuml TRIAM_UseCase_Overview_Combined
skinparam Shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 14
skinparam linetype ortho

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
  FontColor #111827
}

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #1E3A8A
  FontColor #111827
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F172A
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}

left to right direction

'------------- Actors -------------
actor "User" as Reader
actor "Admin" as Admin
actor "Supabase Auth" as Supabase <<System>>

Admin -|> Reader

'------------- System Boundary -------------
rectangle "Hệ thống TRIAM Assistant" {

  package "Phân hệ: Xác thực & Tài khoản" #F1F5F9 {
    (Đăng nhập / Đăng ký) as UC_Auth
    (Đăng xuất) as UC_Logout
    (Đổi / Đặt lại mật khẩu) as UC_ResetPass
  }

  package "Phân hệ: Tài liệu và kế hoạch học" #ECFDF5 {
    (Upload sách) as UC_UploadBook
    (Chọn sách từ thư viện) as UC_SelectBook
    (Tạo và điều chỉnh kế hoạch học tập) as UC_CreatePlan
    (Xem tóm tắt AI của sách) as UC_AI_SUM
    (Tạo lại tóm tắt) as UC_RE_AI_SUM
    (Theo dõi tiến trình xử lý) as UC_TrackJob
    (Nghe sớm bài học) as UC_ListenEarly

    UC_AI_SUM <.. UC_RE_AI_SUM : <<extend>>
    UC_TrackJob <.. UC_ListenEarly : <<extend>>
  }

  package "Phân hệ: Nghe sách nói và tiến độ" #FFFBEB {
    (Nghe audio bài học) as UC_Listen
    (Chuyển đổi chế độ học) as UC_SwitchMode
    (Cập nhật tiến độ nghe) as UC_Progress
    (Theo dõi và điều chỉnh lịch học) as UC_TrackSchedule
  }

  package "Phân hệ: Trợ lý AI theo ngữ cảnh sách" #F3E8FF {
    (Quản lý phiên đàm thoại) as UC_ManageSession
    (Hỏi đáp theo phạm vi tài liệu) as UC_QA
    (Đàm thoại thời gian thực) as UC_LiveKit
    (Yêu cầu tìm kiếm Internet) as UC_Web
    (Cấp quyền tìm kiếm) as UC_Perm

    UC_ManageSession <.. UC_QA : <<extend>>
    UC_ManageSession <.. UC_LiveKit : <<extend>>
    UC_QA <.. UC_Web : <<extend>>
    UC_LiveKit <.. UC_Web : <<extend>>
    UC_Web .> UC_Perm : <<include>>
  }

  package "Phân hệ: Không gian học, ôn tập và thông báo" #FFE4E6 {
    (Quản lý Không gian học tập) as UC_Workspace
    (Liên kết sách vào không gian) as UC_ManageWSBooks
    (Khởi tạo hội thoại trong không gian) as UC_WSChat
    (Hội thoại trực tiếp với sách) as UC_DirectChat

    (Quản lý lịch ôn tập) as UC_Review
    (Theo dõi bài ôn tới hạn) as UC_TrackDueReview
    (Hoàn thành bài ôn) as UC_CompleteReview
    (Bỏ qua bài ôn) as UC_SkipReview

    (Quản lý thông báo) as UC_Notification
    (Theo dõi thông báo) as UC_TrackNotification
    (Cài đặt thông báo) as UC_SetupNotification

    UC_Workspace <.. UC_ManageWSBooks : <<extend>>
    UC_Workspace <.. UC_WSChat : <<extend>>
    UC_Workspace <.. UC_DirectChat : <<extend>>

    UC_Review <.. UC_TrackDueReview : <<extend>>
    UC_Review <.. UC_CompleteReview : <<extend>>
    UC_Review <.. UC_SkipReview : <<extend>>

    UC_Notification <.. UC_TrackNotification : <<extend>>
    UC_Notification <.. UC_SetupNotification : <<extend>>
  }

  package "Phân hệ: Quản trị hệ thống" #F8FAFC {
    (Xem dashboard) as UC_AdminDashboard
    (Quản lý người dùng) as UC_AdminUser
    (Quản lý sách hệ thống) as UC_AdminCatalog
    (Cấu hình chia sẻ sách) as UC_ShareBook
    (Xuất dữ liệu) as UC_ExportData
    (Quản lý tác vụ) as UC_AdminJob
    (Giám sát tác vụ) as UC_MonitorJob
    (Kích hoạt tác vụ) as UC_ActivateJob
    (Xem nhật ký hệ thống) as UC_Audit

    UC_AdminCatalog <.. UC_UploadBook : <<extend>>
    UC_AdminCatalog <.. UC_ShareBook : <<extend>>
    UC_AdminJob <.. UC_MonitorJob : <<extend>>
    UC_AdminJob <.. UC_ActivateJob : <<extend>>
  }
}

'------------- Connections: Actors to Use Cases -------------
' Auth & Account
Reader -- UC_Auth
UC_Auth -- Supabase
Reader -- UC_Logout
Reader -- UC_ResetPass

' Library & Plan
Reader -- UC_UploadBook
Reader -- UC_SelectBook
Reader -- UC_CreatePlan
Reader -- UC_AI_SUM
Reader -- UC_TrackJob

' Listen & Progress
Reader -- UC_Listen
Reader -- UC_SwitchMode
Reader -- UC_Progress
Reader -- UC_TrackSchedule

' AI Assistant
Reader -- UC_ManageSession

' Workspace, Review & Notification
Reader -- UC_Workspace
Reader -- UC_Review
Reader -- UC_Notification

' Admin
Admin -- UC_AdminDashboard
Admin -- UC_AdminUser
Admin -- UC_AdminCatalog
Admin -- UC_ExportData
Admin -- UC_AdminJob
Admin -- UC_Audit

@enduml