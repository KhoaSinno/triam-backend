# Copy this file to .env for local development.
# In deployment, set these values through platform secrets/environment variables.

# Celery / Redis
CELERY_BROKER_URL=redis://default:<redis-password>@<redis-host>:<redis-port>/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_DOCUMENT_CONCURRENCY=1

# Set true only when this runtime should also start a Celery worker.
# For a separate worker deployment, set this true on the worker Space/process.
ENABLE_CELERY_WORKER=false
