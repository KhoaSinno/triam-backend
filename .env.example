# Copy this file to .env for local development.
# In deployment, set these values through platform secrets/environment variables.

# Database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_ECHO=false
# auto: Supabase pooler/port 6543 -> NullPool; otherwise QueuePool.
# null: always disable app-side pooling. queue: always use a small QueuePool.
DATABASE_POOL_MODE=auto
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=5
DATABASE_POOL_RECYCLE=900
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_USE_LIFO=true
DATABASE_APPLICATION_NAME=triam-backend

# Celery / Redis
CELERY_BROKER_URL=redis://default:<redis-password>@<redis-host>:<redis-port>/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_BROKER_POOL_LIMIT=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_DOCUMENT_CONCURRENCY=1
CELERY_NOTIFICATION_CONCURRENCY=1
CELERY_LOG_LEVEL=info
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_WORKER_CANCEL_LONG_RUNNING_ON_CONNECTION_LOSS=false

# Set true only when this runtime should also start a Celery worker.
# For a separate worker deployment, set this true on the worker Space/process.
ENABLE_CELERY_WORKER=false
ENABLE_NOTIFICATION_WORKER=false
ENABLE_CELERY_BEAT=false

# Runtime process toggles
ENABLE_VOICE_AGENT=true
RUN_MIGRATIONS_ON_START=false
UVICORN_RELOAD=false
UV_NO_SYNC=true
BACKEND_PORT=8000

# LiveKit agent runtime hardening
LIVEKIT_AGENT_JOB_EXECUTOR_TYPE=thread
LIVEKIT_AGENT_NUM_IDLE_PROCESSES=1
LIVEKIT_AGENT_MAX_CONCURRENT_JOBS=2
LIVEKIT_AGENT_LOAD_THRESHOLD=0.95
LIVEKIT_AGENT_INITIALIZE_PROCESS_TIMEOUT=60
LIVEKIT_AGENT_SHUTDOWN_PROCESS_TIMEOUT=20

# Realtime voice agent behavior
OPENAI_STREAM_MODEL_NAME=gpt-realtime
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGE=vi
OPENAI_REALTIME_TRANSCRIPTION_PROMPT="Vietnamese audio in the TRIAM audiobook study app. Expect terms: Tri Âm, chương, sách, định lý, phương pháp, GPT, Gemini."
VOICE_AGENT_TEXT_LLM_MODEL=gpt-4o-mini
VOICE_AGENT_ENABLE_WEB_SEARCH_BY_DEFAULT=false
VOICE_AGENT_LOG_TRANSCRIPT_TEXT=false
VOICE_AGENT_DEDUPE_WINDOW_SECONDS=3
VOICE_AGENT_WEB_PERMISSION_TTL_SECONDS=180
VOICE_AGENT_WEB_IMPLICIT_GRANT_WINDOW_SECONDS=20
VOICE_AGENT_WEB_RESULT_CACHE_TTL_SECONDS=120
VOICE_AGENT_PERMISSION_CLASSIFIER_ENABLED=true
VOICE_AGENT_PERMISSION_CLASSIFIER_MODEL=gpt-4o-mini
VOICE_AGENT_PERMISSION_CLASSIFIER_TIMEOUT_SECONDS=1.5
VOICE_AGENT_PERMISSION_CLASSIFIER_CONFIDENCE_THRESHOLD=0.72
VOICE_AGENT_INTERRUPTION_MIN_DURATION_SECONDS=0.8
VOICE_AGENT_INTERRUPTION_MIN_WORDS=2
VOICE_AGENT_FALSE_INTERRUPTION_TIMEOUT_SECONDS=1.5
VOICE_AGENT_PREEMPTIVE_GENERATION_ENABLED=false
VOICE_AGENT_HISTORY_LIMIT=24
VOICE_AGENT_RAG_MAX_CHARS=6000

# Phase 3 generation guardrails
LLM_INPUT_SOFT_TOKEN_LIMIT=12000
LLM_INPUT_HARD_TOKEN_LIMIT=60000
LLM_CHUNK_TARGET_TOKENS=5000
LLM_CHUNK_OVERLAP_TOKENS=300
MAX_ESTIMATED_AUDIO_SECONDS_PER_BOOK=14400
FIRST_PLAYABLE_UNITS=1
LEARNING_UNIT_PROCESSING_CONCURRENCY=2
LLM_NORMALIZE_CONCURRENCY=1

# Text-to-Speech provider
# edge = free/dev provider; google = Google Cloud Text-to-Speech Chirp 3 HD.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
TTS_GENERATION_CONCURRENCY=2
TTS_RECEIVE_TIMEOUT_SECONDS=300
TTS_RETRY_BASE_SECONDS=3
TTS_MIN_TEXT_CHARS=10
GOOGLE_TTS_LANGUAGE_CODE=vi-VN
GOOGLE_TTS_VOICE=vi-VN-Chirp3-HD-Iapetus
GOOGLE_TTS_MAX_BYTES_PER_REQUEST=4500
GOOGLE_TTS_ENABLE_COST_LOG=true

EMBEDDING_BATCH_SIZE=64

# Phase 8 Pareto planner
PARETO_PLANNER_LLM_ENABLED=true
PARETO_PLANNER_MODEL=gemini-2.5-flash
PARETO_PLANNER_TIMEOUT_SECONDS=8
PARETO_PLANNER_MAX_UNITS=8
PARETO_PLANNER_MIN_UNITS=3
PARETO_TARGET_COVERAGE_RATIO=0.25
PARETO_SECTION_EXCERPT_CHARS=700
PARETO_PLANNER_MAX_SECTION_CARDS=120

# Phase 4.1 in-app notification/reminder
NOTIFICATION_SCAN_INTERVAL_SECONDS=60
NOTIFICATION_DELIVERY_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_STALE_LOCK_MINUTES=10
NOTIFICATION_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
NOTIFICATION_DEFAULT_REMINDER_TIME=20:00
NOTIFICATION_DEFAULT_DAILY_CAP=3
NOTIFICATION_DEFAULT_QUIET_START=22:00
NOTIFICATION_DEFAULT_QUIET_END=07:00

# Phase 4.2 production learning loop
MAX_ACTIVE_LEARNING_BOOKS_PER_USER=3
LEARNING_COMPLETION_THRESHOLD_PERCENT=80
LEARNING_PROGRESS_MIN_DELTA_PERCENT=5
LEARNING_PROGRESS_STALE_SECONDS=30
PLAN_REMINDER_STUDIED_TODAY_WINDOW_HOURS=24

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=triam-notification-firebase-adminsdk-fbsvc-77f3e9eac6.json
